{
  "name": "smart-hospital-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0 <23 || >=24.2.0 <25"
  },
  "scripts": {
    "dev:server": "npm run dev -w @smart-hospital/server",
    "dev:app": "npm run dev -w @smart-hospital/app",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.tools.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint packages/app/src scripts tests playwright.config.ts vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:api && npm run test:e2e",
    "test": "vitest run",
    "test:api": "tsx tests/api.integration.ts",
    "test:e2e": "playwright test",
    "test:persistence": "tsx scripts/check-persistence.ts",
    "seed": "tsx scripts/seed.ts",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose stop"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
