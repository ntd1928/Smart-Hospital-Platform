# Docker demo defaults for localhost only. Never use real credentials/data here.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=medplum
REDIS_PORT=6379
REDIS_PASSWORD=medplum
# POSTGRES_PORT/REDIS_PORT are published only by docker-compose.dev.yml.
